
RBASE = "/rtsess01/compute/juno/bic/ROOT/rscr/references/Mus_musculus/BIC_MSK/GRCm38"
params {
    bwa                   = "${RBASE}/Sequence/BWAIndex/Version0.7.17/"
    dict                  = "${RBASE}/Sequence/WholeGenomeFasta/GRCm38.dict"
    fasta                 = "${RBASE}/Sequence/WholeGenomeFasta/GRCm38.fa"
    fasta_fai             = "${RBASE}/Sequence/WholeGenomeFasta/GRCm38.fa.fai"
    fasta_bed             = "/rtsess01/compute/juno/bic/ROOT/work/kristakaz/GRCm38.bed"
    intervals             = "/rtsess01/compute/juno/bic/ROOT/work/kristakaz/GRCm38/Targets/M-IMPACT_v2_mm10_targets__1000pad.bed"
    //intervals             = "${RBASE}/Annotation/intervals/GRCm38_calling_list.bed"
    dbsnp                 = "${RBASE}/Annotation/Variation/Mus_musculus.vcf.gz"
    dbsnp_tbi             = "${RBASE}/Annotation/Variation/Mus_musculus.vcf.gz.tbi"
    known_snps            = "${RBASE}/MouseGenomeProject/mgp.v5.merged.snps_all.dbSNP142.vcf.gz"
    known_snps_tbi        = "${RBASE}/MouseGenomeProject/mgp.v5.merged.snps_all.dbSNP142.vcf.gz.tbi"
    known_indels          = "${RBASE}/MouseGenomeProject/mgp.v5.merged.indels.dbSNP142.normed.vcf.gz"
    known_indels_tbi      = "${RBASE}/MouseGenomeProject/mgp.v5.merged.indels.dbSNP142.normed.vcf.gz.tbi"
    pon                   = "${RBASE}/PoN/pon.vcf.gz"
    pon_tbi               = "${RBASE}/PoN/pon.vcf.gz.tbi"
    germline_resource     = "${RBASE}/Annotation/GermlineEvents/mgp.v5.merged.ALL.dbSNP142.AF_InfoOnly.vcf.gz"
    germline_resource_tbi = "${RBASE}/Annotation/GermlineEvents/mgp.v5.merged.ALL.dbSNP142.AF_InfoOnly.vcf.gz.tbi"
    mappability           = "${RBASE}/Annotation/Control-FREEC/GRCm38_68_mm10.gem"
    readme                = "${RBASE}/Annotation/README.txt"
    snpeff_db             = 99
    snpeff_genome         = 'GRCm38'
    vep_cache_version     = 102
    vep_genome            = 'GRCm38'
    vep_species           = 'mus_musculus'
    //vardict_bed      = '../../assets/bic/assets/bic/M-IMPACT_v2_mm10_targets__1000pad.bed'
}
// for right now vardict_bed is different than intervals, but Nick runs it with vardict_bed in both params.
// Still looking to see if this is correct
// He changes the value when the runs sarek to the value in vardict_bed, so I'm just going to run it with the bed he provides to sarek

plugins {
    id 'nf-co2footprint@1.0.0-beta' // carbon footprint plugin
}


process {
    withName: VARDICTJAVA {
       ext.args = '-f 0.01 -c 1 -S 2 -E 3 -N ${meta.tumor_id}'
       ext.args2 = ''
       ext.args3 = '-f 0.01 -N "${meta.tumor_id}|${meta.normal_id}" -b ${params.fasta_bed}'
       publishDir = [
            [
                path: { "${params.outdir}/variant_calling/vardict/${meta.id}" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }
}
